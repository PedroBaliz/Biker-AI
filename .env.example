# Chave de acesso da API do Gemini (Server-side Only)
GEMINI_API_KEY=

# Credenciais administrativas do Treinador/Admin (Server-side Only)
ADMIN_PASSWORD=
# E-mail da conta master (treinador principal). Obrigatório em produção: sem ele,
# nenhum e-mail recebe o privilégio master (coaches por role e ADMIN_PASSWORD continuam valendo).
ADMIN_EMAIL=

# Firebase server configuration (required in Vercel/serverless deployments)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_FIRESTORE_DATABASE_ID=

# Paywall (trial de 3 dias + assinatura). Desligado: todo atleta logado tem acesso completo (ADR-008).
# Para religar, defina os dois como "true" — e integre antes um meio de pagamento.
PAYWALL_ENABLED=
VITE_PAYWALL_ENABLED=

# Meta (Facebook) Pixel ID
VITE_FACEBOOK_PIXEL_ID=1367412024814466
