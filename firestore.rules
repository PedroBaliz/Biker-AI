rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(email) {
      return isSignedIn() && (
        request.auth.token.email.lower() == email.lower() ||
        request.auth.uid == email
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'pedro.bramos@sempreceub.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Secured users collection: athletes can only access and update their own document; admins have full management access
    match /users/{email} {
      allow get: if isOwner(email) || isAdmin();
      allow list: if isAdmin();

      // On create, non-admins cannot self-assign role 'coach'/'admin', isCoach=true, or active subscription
      allow create: if (isOwner(email) || isAdmin()) && (
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 128 &&
        (isAdmin() || (
          (!('profile' in request.resource.data) || !('role' in request.resource.data.profile) || request.resource.data.profile.role == 'athlete') &&
          (!('profile' in request.resource.data) || !('isCoach' in request.resource.data.profile) || request.resource.data.profile.isCoach == false) &&
          (!('profile' in request.resource.data) || !('subscriptionStatus' in request.resource.data.profile) || request.resource.data.profile.subscriptionStatus == 'pending_payment')
        ))
      );

      // On update, athletes cannot modify privileged fields (role, isCoach, subscriptionStatus, subscriptionExpiresAt)
      allow update: if (isOwner(email) || isAdmin()) && (
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 128 &&
        (isAdmin() || (
          (!('profile' in resource.data) || !('profile' in request.resource.data)) ||
          (
            (!('role' in resource.data.profile) || request.resource.data.profile.role == resource.data.profile.role) &&
            (!('subscriptionStatus' in resource.data.profile) || request.resource.data.profile.subscriptionStatus == resource.data.profile.subscriptionStatus) &&
            (!('isCoach' in resource.data.profile) || request.resource.data.profile.isCoach == resource.data.profile.isCoach) &&
            (!('subscriptionExpiresAt' in resource.data.profile) || request.resource.data.profile.subscriptionExpiresAt == resource.data.profile.subscriptionExpiresAt)
          )
        ))
      );

      allow delete: if isAdmin();
    }
  }
}

