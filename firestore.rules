rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(email) {
      return isSignedIn() && (
        request.auth.token.email.lower() == email.lower() ||
        request.auth.uid == email
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'pedro.bramos@sempreceub.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Secured users collection: athletes can only access and update their own document; admins have full management access
    match /users/{email} {
      allow get: if isOwner(email) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if (isOwner(email) || isAdmin()) && (
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 128
      );
      allow delete: if isAdmin();
    }
  }
}

