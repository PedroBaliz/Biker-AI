rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(email) {
      return isSignedIn() && (
        request.auth.token.email.lower() == email.lower() ||
        request.auth.uid == email
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'pedro.bramos@sempreceub.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Explicit list of athlete-editable profile fields
    function allowedProfileKeys() {
      return [
        'name',
        'level',
        'goal',
        'daysPerWeek',
        'durationPerSession',
        'eventDate',
        'hasPowerMeter',
        'ftp',
        'hasHeartRate',
        'maxHeartRate',
        'limitations',
        'recentActivity',
        'onboardingStep'
      ];
    }

    // Allowed top-level keys that athletes may modify on update
    function allowedTopLevelUpdateKeys() {
      return [
        'profile',
        'chatHistory',
        'plan',
        'feedbacks',
        'workoutLogs',
        'password'
      ];
    }

    // Validates that profile update strictly affects only allowed non-privileged fields,
    // even when privileged fields were previously absent or profile was absent.
    function isSafeProfileUpdate() {
      return !('profile' in request.resource.data.diff(resource.data).affectedKeys()) ||
        (
          ('profile' in request.resource.data) &&
          (
            (!('profile' in resource.data) && request.resource.data.profile.keys().hasOnly(allowedProfileKeys())) ||
            (('profile' in resource.data) && request.resource.data.profile.diff(resource.data.profile).affectedKeys().hasOnly(allowedProfileKeys()))
          )
        );
    }

    // Secured users collection: athletes can only access and update their own document; admins have full management access
    match /users/{email} {
      allow get: if isOwner(email) || isAdmin();
      allow list: if isAdmin();

      // On create, non-admins cannot self-assign role 'coach'/'admin', isCoach=true, or active subscription
      allow create: if (isOwner(email) || isAdmin()) && (
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 128 &&
        (
          isAdmin() ||
          (
            !('profile' in request.resource.data) ||
            (
              (!('role' in request.resource.data.profile) || request.resource.data.profile.role == 'athlete') &&
              (!('isCoach' in request.resource.data.profile) || request.resource.data.profile.isCoach == false) &&
              (!('subscriptionStatus' in request.resource.data.profile) || request.resource.data.profile.subscriptionStatus == 'pending_payment') &&
              (!('subscriptionExpiresAt' in request.resource.data.profile)) &&
              request.resource.data.profile.keys().hasOnly(
                allowedProfileKeys().concat(['role', 'isCoach', 'subscriptionStatus', 'subscriptionPlan', 'createdAt'])
              )
            )
          )
        )
      );

      // On update, athletes cannot modify privileged fields (role, isCoach, subscriptionStatus, subscriptionPlan, subscriptionExpiresAt, createdAt)
      // Enforced strictly via diff().affectedKeys().hasOnly(...)
      allow update: if (isOwner(email) || isAdmin()) && (
        request.resource.data.email is string &&
        request.resource.data.email == resource.data.email &&
        (
          isAdmin() ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedTopLevelUpdateKeys()) &&
            isSafeProfileUpdate()
          )
        )
      );

      allow delete: if isAdmin();
    }
  }
}

